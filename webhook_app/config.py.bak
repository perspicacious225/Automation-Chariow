import os
from pathlib import Path
from dotenv import load_dotenv

load_dotenv()

class Config:
    BASE_DIR = Path(__file__).parent.parent
    DUM_DIR = BASE_DIR / "webhook_app" / "templates"/ "last_webhook.json"
    
    # Database
    DB_PATH = BASE_DIR / "webhook.db"
    
    # WhatsApp
    INSTANCE_ID = os.getenv("WHATSAPP_INSTANCE_ID")
    TOKEN = os.getenv("WHATSAPP_TOKEN")
    API_URL = f"https://api.green-api.com/waInstance{INSTANCE_ID}/sendMessage/{TOKEN}"
    
    # Google Sheets
    CREDS_PATH = os.getenv("GOOGLE_SHEETS_CREDENTIALS")
    SHEET_ID = os.getenv("GOOGLE_SHEET_ID")
    
    # Security
    WEBHOOK_SECRET = os.getenv("WEBHOOK_SECRET")
    

    # Send Email Settings

    SENDER_EMAIL = "contact.digitechub@gmail.com"


    
